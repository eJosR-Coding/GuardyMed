# Copy to .env (git-ignored) or export these in your shell. Every value is optional.
GUARDYMED_ENVIRONMENT=development
GUARDYMED_DATABASE_URL=sqlite+pysqlite:///./guardymed.db
# Public demo accounts and sample data. Set to false for anything that is not a demo.
GUARDYMED_DEMO_MODE=true
# Set to true when serving over HTTPS.
GUARDYMED_SESSION_COOKIE_SECURE=false
# "stub" = simulated recognition, no ML dependencies. "insightface" = real model (needs `uv sync --extra cv`).
GUARDYMED_ATTENDANCE_CV_RUNTIME=stub
GUARDYMED_ATTENDANCE_CV_ACCEPT_THRESHOLD=0.45
GUARDYMED_ATTENDANCE_CV_REVIEW_THRESHOLD=0.25
